package q11268;
public class OverloadArea {
    // Write the overload method for area of square
    public static float area(float side) {
        return side * side;
    }
    // Overloaded method to find area of a rectangle
    public static float area(float length, float breadth) {
        return length * breadth;
    }
    public static void main(String[] args) {
        // Write the code to parse args
        float f1 = Float.parseFloat(args[0]);
        float f2 = Float.parseFloat(args[1]);
        System.out.println("Area of square for side in meters " + f1 + " is " + area(f1));
        // Print area of rectangle
        System.out.println("Area of rectangle for length and breadth in meters " + f1 + "," + f2 + " is " + area(f1, f2));
    }
}
